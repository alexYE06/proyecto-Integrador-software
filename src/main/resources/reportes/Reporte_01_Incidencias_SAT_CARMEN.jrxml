<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="Reporte_01_Incidencias_SAT_CARMEN" 
              language="java" 
              pageWidth="842" 
              pageHeight="595" 
              orientation="Landscape" 
              columnWidth="786" 
              leftMargin="28" 
              rightMargin="28" 
              topMargin="22" 
              bottomMargin="22" 
              whenNoDataType="AllSectionsNoDetail">
              
    <queryString language="SQL">
        <![CDATA[
        SELECT
            a.id_alerta AS id_alerta,
            DATE_FORMAT(a.fecha_hora, '%d/%m/%Y %H:%i') AS fecha_hora,
            CONCAT(c.nombres, ' ', c.apellidos) AS conductor,
            b.codigo_unidad AS unidad,
            a.tipo_activacion AS tipo_alerta,
            CASE
                WHEN g.latitud IS NOT NULL AND g.longitud IS NOT NULL
                  THEN CONCAT(ROUND(g.latitud, 5), ', ', ROUND(g.longitud, 5))
                ELSE 'Sin posición GPS'
            END AS ubicacion,
            a.estado AS estado
        FROM alerta a
        INNER JOIN conductor c ON c.id_conductor = a.id_conductor
        INNER JOIN bus b ON b.id_bus = a.id_bus
        LEFT JOIN telemetria_gps g
            ON g.id_telemetria = (
                SELECT tg.id_telemetria
                FROM telemetria_gps tg
                WHERE tg.id_alerta = a.id_alerta
                ORDER BY tg.fecha_hora DESC, tg.id_telemetria DESC
                LIMIT 1
            )
        ORDER BY a.fecha_hora DESC, a.id_alerta DESC
        ]]>
    </queryString>

    <field name="id_alerta" class="java.lang.Integer"/>
    <field name="fecha_hora" class="java.lang.String"/>
    <field name="conductor" class="java.lang.String"/>
    <field name="unidad" class="java.lang.String"/>
    <field name="tipo_alerta" class="java.lang.String"/>
    <field name="ubicacion" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>

