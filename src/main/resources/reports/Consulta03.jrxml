      <textField pattern="#,##0"><reportElement x="609" y="18" width="165" height="20" forecolor="#D41C3C"/><textElement><font size="15" isBold="true"/></textElement><textFieldExpression>$F{periodo_auxilio}</textFieldExpression></textField>

      <staticText><reportElement x="0" y="48" width="383" height="14" forecolor="#21344B"/><textElement><font size="9" isBold="true"/></textElement><text>ALERTAS POR DÍA</text></staticText>
      <staticText><reportElement x="403" y="48" width="383" height="14" forecolor="#21344B"/><textElement><font size="9" isBold="true"/></textElement><text>ESTADOS POR BUS (10 CON MÁS ALERTAS)</text></staticText>

