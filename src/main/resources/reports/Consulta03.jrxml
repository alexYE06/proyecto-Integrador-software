    <staticText><reportElement x="94" y="38" width="650" height="15" forecolor="#D5DFEA"/><textElement verticalAlignment="Middle"><font size="9"/></textElement><text>Tendencia diaria y distribución de estados por unidad</text></staticText>
    <textField><reportElement x="94" y="56" width="665" height="12" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression>"Periodo: " + ($P{FECHA_INICIO} == null ? "sin límite inicial" : new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{FECHA_INICIO})) + " — " + ($P{FECHA_FIN} == null ? "sin límite final" : new java.text.SimpleDateFormat("dd/MM/yyyy").format(new java.util.Date($P{FECHA_FIN}.getTime()-86400000L))) + " | Emitido: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())</textFieldExpression></textField>
  </band></title>

