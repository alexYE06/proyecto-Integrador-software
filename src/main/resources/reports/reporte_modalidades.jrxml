<?xml version='1.0' encoding='UTF-8'?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_modalidades" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="786" leftMargin="28" rightMargin="28" topMargin="22" bottomMargin="22" whenNoDataType="AllSectionsNoDetail">
  <parameter name="FECHA_INICIO" class="java.sql.Timestamp" isForPrompting="true"><parameterDescription><![CDATA[Desde fecha/hora incluida; vacio = sin limite]]></parameterDescription><defaultValueExpression><![CDATA[null]]></defaultValueExpression></parameter><parameter name="FECHA_FIN_EXCLUSIVA" class="java.sql.Timestamp" isForPrompting="true"><parameterDescription><![CDATA[Hasta antes del inicio del dia posterior; vacio = sin limite]]></parameterDescription><defaultValueExpression><![CDATA[null]]></defaultValueExpression></parameter><parameter name="ESTADO" class="java.lang.String" isForPrompting="true"><parameterDescription><![CDATA[Estado exacto almacenado; vacio = todos]]></parameterDescription><defaultValueExpression><![CDATA[null]]></defaultValueExpression></parameter><parameter name="ID_BUS" class="java.lang.Integer" isForPrompting="true"><parameterDescription><![CDATA[ID real de bus; vacio = todos]]></parameterDescription><defaultValueExpression><![CDATA[null]]></defaultValueExpression></parameter><parameter name="TIPO_ACTIVACION" class="java.lang.String" isForPrompting="true"><parameterDescription><![CDATA[Modalidad exacta almacenada; vacio = todas]]></parameterDescription><defaultValueExpression><![CDATA[null]]></defaultValueExpression></parameter><queryString language="SQL"><![CDATA[SELECT a.tipo_activacion AS categoria, COUNT(*) AS cantidad, ROUND(100.0 * COUNT(*) / NULLIF((SELECT COUNT(*) FROM alerta a WHERE ($P{FECHA_INICIO} IS NULL OR a.fecha_hora >= $P{FECHA_INICIO}) AND ($P{FECHA_FIN_EXCLUSIVA} IS NULL OR a.fecha_hora < $P{FECHA_FIN_EXCLUSIVA}) AND ($P{ESTADO} IS NULL OR TRIM($P{ESTADO}) = '' OR a.estado = $P{ESTADO}) AND ($P{ID_BUS} IS NULL OR a.id_bus = $P{ID_BUS}) AND ($P{TIPO_ACTIVACION} IS NULL OR TRIM($P{TIPO_ACTIVACION}) = '' OR a.tipo_activacion = $P{TIPO_ACTIVACION})),0),2) AS porcentaje FROM alerta a WHERE ($P{FECHA_INICIO} IS NULL OR a.fecha_hora >= $P{FECHA_INICIO})
  AND ($P{FECHA_FIN_EXCLUSIVA} IS NULL OR a.fecha_hora < $P{FECHA_FIN_EXCLUSIVA})
  AND ($P{ESTADO} IS NULL OR TRIM($P{ESTADO}) = '' OR a.estado = $P{ESTADO})
  AND ($P{ID_BUS} IS NULL OR a.id_bus = $P{ID_BUS})
  AND ($P{TIPO_ACTIVACION} IS NULL OR TRIM($P{TIPO_ACTIVACION}) = '' OR a.tipo_activacion = $P{TIPO_ACTIVACION}) GROUP BY a.tipo_activacion ORDER BY cantidad DESC, categoria ASC]]></queryString>
  <field name="categoria" class="java.lang.String"/><field name="cantidad" class="java.lang.Long"/><field name="porcentaje" class="java.math.BigDecimal"/><variable name="TOTAL_ALERTAS" class="java.lang.Long" calculation="Sum"><variableExpression><![CDATA[$F{cantidad}]]></variableExpression></variable><title>
