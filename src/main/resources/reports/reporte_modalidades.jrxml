icText><reportElement uuid="fe18d38d-bfe5-4259-b135-732a856c82cd" x="656" y="30" width="115" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[PORCENTAJE]]></text></staticText></band>
