<jasperReport name="reporte_alertas_por_dia" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="786" leftMargin="28" rightMargin="28" topMargin="22" bottomMargin="22" uuid="3d3932db-ba90-4759-8f86-f6a55dde735b">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="sistema_alertas"/>
	<dataset name="GraficoDiario" uuid="1e17d829-32fe-4dd7-a395-a94d79f9a60c">
		<parameter name="FECHA_INICIO" class="java.sql.Timestamp"/>
		<parameter name="FECHA_FIN" class="java.sql.Timestamp"/>
		<query language="SQL"><![CDATA[SELECT DATE(a.fecha_hora) AS dia,
                   DATE_FORMAT(DATE(a.fecha_hora), '%d/%m/%y') AS dia_etiqueta,
                   COUNT(CASE WHEN a.estado = 'Atendida' THEN 1 END) AS atendidas,
                   COUNT(CASE WHEN a.estado = 'Falsa Alarma' THEN 1 END) AS falsas_alarmas,
                   COUNT(CASE WHEN a.estado IN ('Recibida', 'En Evaluación', 'Auxilio Despachado') THEN 1 END) AS abiertas
            FROM alerta a
            WHERE ($P{FECHA_INICIO} IS NULL OR a.fecha_hora >= $P{FECHA_INICIO})
              AND ($P{FECHA_FIN} IS NULL OR a.fecha_hora < $P{FECHA_FIN})
            GROUP BY DATE(a.fecha_hora), DATE_FORMAT(DATE(a.fecha_hora), '%d/%m/%y')
            ORDER BY dia]]></query>
		<field name="dia" class="java.sql.Date"/>
		<field name="dia_etiqueta" class="java.lang.String"/>
		<field name="atendidas" class="java.lang.Long"/>
		<field name="falsas_alarmas" class="java.lang.Long"/>
		<field name="abiertas" class="java.lang.Long"/>
	</dataset>
	<parameter name="FECHA_INICIO" class="java.sql.Timestamp">
		<description><![CDATA[Fecha/hora inicial inclusiva; null significa sin límite inferior.]]></description>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="FECHA_FIN" class="java.sql.Timestamp">
		<description><![CDATA[Fecha/hora final exclusiva; null significa sin límite superior.]]></description>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT d.*,
               SUM(d.total_alertas) OVER () AS periodo_total,
               SUM(d.atendidas) OVER () AS periodo_atendidas,
               SUM(d.falsas_alarmas) OVER () AS periodo_falsas_alarmas,
               SUM(d.abiertas) OVER () AS periodo_abiertas
        FROM (
            SELECT DATE(a.fecha_hora) AS dia,
                   COUNT(*) AS total_alertas,
                   COUNT(CASE WHEN a.estado = 'Atendida' THEN 1 END) AS atendidas,
                   COUNT(CASE WHEN a.estado = 'Falsa Alarma' THEN 1 END) AS falsas_alarmas,
                   COUNT(CASE WHEN a.estado IN ('Recibida', 'En Evaluación', 'Auxilio Despachado') THEN 1 END) AS abiertas
            FROM alerta a
            WHERE ($P{FECHA_INICIO} IS NULL OR a.fecha_hora >= $P{FECHA_INICIO})
              AND ($P{FECHA_FIN} IS NULL OR a.fecha_hora < $P{FECHA_FIN})
            GROUP BY DATE(a.fecha_hora),
         DATE_FORMAT(DATE(a.fecha_hora), '%d/%m/%y')
        ) d
        ORDER BY d.dia]]></query>
	<field name="dia" class="java.sql.Date"/>
	<field name="total_alertas" class="java.lang.Long"/>
	<field name="atendidas" class="java.lang.Long"/>
	<field name="falsas_alarmas" class="java.lang.Long"/>
	<field name="abiertas" class="java.lang.Long"/>
	<field name="periodo_total" class="java.math.BigDecimal"/>
	<field name="periodo_atendidas" class="java.math.BigDecimal"/>
	<field name="periodo_falsas_alarmas" class="java.math.BigDecimal"/>
	<field name="periodo_abiertas" class="java.math.BigDecimal"/>
